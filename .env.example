# This app has no server-side configuration. The league is chosen in the UI and
# carried in the URL as ?league=<id>, so the same deployment serves any number
# of leagues.
#
# The only variable that exists is for the test suite, which needs a real public
# group to verify the scoring engine against. It is never read by the app.
#
#   TEST_LEAGUE_ID=<group-id>
#
# To find a group id, open the league on espn.com and copy the id from the end
# of the URL, after /group/.
TEST_LEAGUE_ID=
